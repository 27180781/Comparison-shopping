# ─── Database ────────────────────────────────────────
# +psycopg selects psycopg 3, which is what requirements.txt installs. A bare
# postgresql:// URL makes SQLAlchemy reach for psycopg2, which is not installed.
# (config.py normalises it anyway, so a pasted URL still works.)
DATABASE_URL=postgresql+psycopg://price:price@localhost:5432/pricecompare
REDIS_URL=redis://localhost:6379/0

# ─── Cloudflare R2 (S3-compatible) ───────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=price-raw
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ─── Scraper ─────────────────────────────────────────
# רשימת הרשתות. ראה docs/02-DATA-SOURCES.md
# אומת מול il-supermarket-scraper 1.0.8 — ראה docs/PHASE0-FINDINGS.md.
# VICTORY ו-MAHSANI_ASHUK הוסרו מהספרייה; ה-*_NEW_SOURCE הם המקור היחיד היום.
# הרץ `python scripts/phase0_verify_scrapers.py` אחרי כל שדרוג של הספרייה.
ENABLED_SCRAPERS=SHUFERSAL,RAMI_LEVY,YAYNO_BITAN_AND_CARREFOUR,VICTORY_NEW_SOURCE,MAHSANI_ASHUK_NEW_SOURCE,OSHER_AD,MAAYAN_2000,NETIV_HASED,SHEFA_BARCART_ASHEM,ZOL_VEBEGADOL,SHUK_AHIR,MESHMAT_YOSEF_1,MESHMAT_YOSEF_2
# PRICE_FILE / PROMO_FILE הם דלתות בלבד. ה-snapshot המלא הוא *_FULL_FILE נפרד.
ENABLED_FILE_TYPES=STORE_FILE,PRICE_FILE,PROMO_FILE,PRICE_FULL_FILE,PROMO_FULL_FILE
NUMBER_OF_PROCESSES=5
STORAGE_PATH=./dumps

# ─── Geocoding ───────────────────────────────────────
# בלי מפתח, סניפים לא ימוקמו וחיפוש לפי מרחק יחזיר ריק.
GOOGLE_MAPS_API_KEY=
# מתחת לסף הזה הסניף לא נחשב אמין לחיפוש מרחק ונכנס לתור אימות ידני.
# 1.0=ROOFTOP · 0.85=RANGE_INTERPOLATED · 0.6=GEOMETRIC_CENTER
GEOCODE_CONFIDENCE_MIN=0.6

# ─── Catalog tuning ──────────────────────────────────
# נקבע במדידה #4 — ראה docs/PHASE0-FINDINGS.md §0.
# 62.7% מהברקודים מופיעים ברשת אחת בלבד (מותג פרטי / פריט ייחודי) ואין להם
# מקבילה להשוואה. הסף 2 חותך בדיוק שם ומשאיר 5,605 מוצרים בני־השוואה.
# הערך הקודם, 4, השאיר 1,219 בלבד. מדוד מחדש אחרי קליטה של כל 12 הרשתות.
CATALOG_MIN_CHAIN_COUNT=2
MATCH_CONFIDENCE_AUTO=0.92
MATCH_CONFIDENCE_REVIEW=0.80

# ─── Basket optimizer ────────────────────────────────
DEFAULT_SEARCH_RADIUS_KM=10
TRAVEL_PENALTY_PER_STOP_ILS=15
TRAVEL_TIME_VALUE_ILS_PER_HOUR=40

# ─── Search ──────────────────────────────────────────
# סף word_similarity לחיפוש עברי. נמוך מדי = רעש, גבוה מדי = לא מוצא
# שאילתות קצרות. ראה api/routers/search.py.
SEARCH_TRIGRAM_THRESHOLD=0.25
SEARCH_RESULT_LIMIT=20
STORES_PER_PRODUCT_LIMIT=25

# ─── Ingestion ───────────────────────────────────────
# 0 = בלי הגבלה. שימושי לבדיקות: FILES_PER_CHAIN_LIMIT=2
FILES_PER_CHAIN_LIMIT=0
SCRAPER_TIMEOUT_SECONDS=1800
# התראה כשנפח הקבצים של רשת יורד מתחת לאחוז הזה מהממוצע שלה עצמה
VOLUME_DROP_ALERT_PCT=50
VOLUME_BASELINE_RUNS=7
# שמור קבצים מקומית אחרי הקליטה. false בפרודקשן — 5-15GB ביום
KEEP_LOCAL_FILES=false

# ─── API ─────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=INFO
